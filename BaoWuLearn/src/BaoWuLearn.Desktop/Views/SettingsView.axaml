<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BaoWuLearn.Desktop.ViewModels"
             xmlns:services="using:BaoWuLearn.Desktop.Services"
             x:Class="BaoWuLearn.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Margin="{DynamicResource PageMargin}" Spacing="{DynamicResource SpacePage}" MaxWidth="760" HorizontalAlignment="Left">

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="外观" Classes="h2" />
          <TextBlock Text="换皮肤会立刻生效；点「保存设置」写入本机，下次启动自动恢复。"
                     Classes="dim" FontSize="12" TextWrapping="Wrap" />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Spacing="6">
              <TextBlock Text="皮肤" Classes="label" />
              <ComboBox ItemsSource="{Binding AvailableSkins}"
                        SelectedItem="{Binding SelectedSkin}"
                        MinWidth="200" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="services:SkinOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="界面密度" Classes="label" />
              <ComboBox SelectedIndex="{Binding UiDensity}"
                        MinWidth="200" HorizontalAlignment="Stretch">
                <ComboBoxItem>舒适（更松）</ComboBoxItem>
                <ComboBoxItem>紧凑（推荐）</ComboBoxItem>
              </ComboBox>
            </StackPanel>
          </Grid>

          <TextBlock Text="紧凑：页边距、卡片内边距与按钮整体收紧，1120×740 不最大化也能看到更多信息。"
                     Classes="faint" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="行为拟人化" Classes="h2" />
          <TextBlock Text="{Binding HumanizeDescription}"
                     Classes="dim" FontSize="12" TextWrapping="Wrap" />

          <StackPanel Spacing="6">
            <TextBlock Text="强度档位" Classes="label" />
            <ComboBox SelectedIndex="{Binding HumanizeLevel}"
                      HorizontalAlignment="Left" MinWidth="240">
              <ComboBoxItem>关闭（仅调试，心跳固定 60 秒）</ComboBoxItem>
              <ComboBoxItem>轻度（小幅抖动）</ComboBoxItem>
              <ComboBoxItem>标准（推荐）</ComboBoxItem>
            </ComboBox>
          </StackPanel>

          <Border Background="{DynamicResource PanelSoftBrush}" CornerRadius="6" Padding="12">
            <StackPanel Spacing="4">
              <TextBlock Text="当前心跳区间" Classes="label" />
              <TextBlock Text="{Binding HeartbeatRange}" FontWeight="SemiBold" />
            </StackPanel>
          </Border>

          <CheckBox Content="课程之间插入随机停顿（30–120 秒）"
                    IsChecked="{Binding RandomCourseGap}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="挂课完成策略" Classes="h2" />
          <TextBlock Text="决定一门课挂到什么程度才算完、换下一门。改完点下方「保存设置」，对正在挂的课立即生效（下一门课开始按新策略折算）。"
                     Classes="dim" FontSize="12" TextWrapping="Wrap" />

          <StackPanel Spacing="6">
            <TextBlock Text="策略" Classes="label" />
            <ComboBox SelectedIndex="{Binding CompletionPolicy}"
                      HorizontalAlignment="Left" MinWidth="240">
              <ComboBoxItem>挂满才跳（推荐，成绩最稳）</ComboBoxItem>
              <ComboBoxItem>及格就跳（省时间，成绩停在及格线）</ComboBoxItem>
            </ComboBox>
          </StackPanel>

          <Border Background="{DynamicResource PanelSoftBrush}" CornerRadius="6" Padding="12">
            <TextBlock Text="{Binding PolicyDescription}"
                       FontSize="12" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="账号与密码" Classes="h2" />
          <TextBlock Text="{Binding AccountSummary}"
                     Classes="dim" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="「记住账户」与「保存密码」的开关在登录页；密码用本机密钥加密后存放，不保存明文，换一台机器也解不开。"
                     Classes="faint" FontSize="11" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="清除已保存的密码"
                    Command="{Binding ClearSavedPasswordsCommand}" />
            <TextBlock Text="{Binding AccountActionStatus}"
                       Classes="dim" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="课件下载" Classes="h2" />
          <TextBlock Text="视频从平台公开视频区下载（与挂机心跳互不影响）；PDF/附件走登录会话。产物按「根目录/宝武学习助手/课程名/」归档。"
                     Classes="dim" FontSize="12" TextWrapping="Wrap" />
          <StackPanel Spacing="6">
            <TextBlock Text="下载根目录（留空 = 系统「下载」文件夹）" Classes="label" />
            <TextBox Text="{Binding DownloadDirText}" Watermark="例如 /Users/you/Videos/课程 或 D:\课程" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="自动更新" Classes="h2" />
          <TextBlock Text="启动后与每 24 小时各静默检查一次；发现新版本只在顶部亮横幅，点「立即更新」才会下载与替换。清单带 ed25519 签名，任何中转节点都伪造不了新版本或产物内容。"
                     Classes="dim" FontSize="12" TextWrapping="Wrap" />
          <CheckBox Content="启用自动检查更新" IsChecked="{Binding UpdateChecksEnabled}" />
          <StackPanel Spacing="6">
            <TextBlock Text="镜像前缀（一行一个，GitHub 直连失败时按顺序兜底；留空 = 只用内置推荐列表）" Classes="label" />
            <TextBox Text="{Binding UpdateMirrorsText}"
                     AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap"
                     FontFamily="Menlo, Consolas, monospace" FontSize="12" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="立即检查更新"
                    Command="{Binding CheckUpdateNowCommand}" />
            <TextBlock Text="{Binding UpdateCheckStatus}"
                       Classes="dim" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="镜像走公共反代时只可能让你下载失败，不可能让你装到坏东西（验签在解析之前）。改完列表记得点下方「保存设置」。"
                     Classes="faint" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="接口自检" Classes="h2" />
          <TextBlock Text="拉取一张验证码，验证平台网关连通性与响应结构是否发生变化。"
                     Classes="dim" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelfTestResult}"
                     FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextBrush}" />
          <Button Content="测试平台连通性"
                  HorizontalAlignment="Left"
                  Command="{Binding SelfTestCommand}"
                  IsEnabled="{Binding !IsTesting}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="配置文件位置" Classes="label" />
          <TextBlock Text="{Binding ConfigPath}"
                     Classes="faint" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Classes="primary" Content="保存设置" Command="{Binding SaveCommand}" />
        <TextBlock Text="{Binding SaveStatus}"
                   Classes="dim" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
