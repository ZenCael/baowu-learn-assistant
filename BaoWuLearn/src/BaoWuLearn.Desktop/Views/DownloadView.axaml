<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BaoWuLearn.Desktop.ViewModels"
             x:Class="BaoWuLearn.Desktop.Views.DownloadView"
             x:DataType="vm:DownloadViewModel">

  <!-- ══ 课件下载（v1.0.45 改版）══
       拆成两个页签：课程列表（来源=挂机队列，标题里写明）/ 下载列表。
       排任务后自动切到下载列表；任务行进度条与按钮各占固定列位，互不压叠。 -->
  <Grid RowDefinitions="Auto,*">

    <Border Classes="card" Margin="0,0,0,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusText}" FontSize="12.5" TextWrapping="Wrap" />
          <TextBlock Text="{Binding OpenRootHint}" Classes="faint" FontSize="11" />
        </StackPanel>
        <Button Grid.Column="1" Content="更改保存目录…" Margin="12,0,0,0"
                VerticalAlignment="Center" Click="PickRoot_Click"
                ToolTip.Tip="选择课件保存位置（立即生效并记住）" />
      </Grid>
    </Border>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">

      <!-- ── 页签一：课程列表（挂机队列） ── -->
      <TabItem Header="{Binding CoursesTabHeader}">
        <ScrollViewer>
          <StackPanel Spacing="10">

            <Border Classes="card" Padding="12,8">
              <TextBlock Classes="dim" FontSize="11.5" TextWrapping="Wrap"
                         Text="课程来自挂机队列：在挂机页加入队列的课才出现在这里。展开看课件清单，也可以直接点「全部下载」——目录没加载过会自动先加载。" />
            </Border>

            <ItemsControl ItemsSource="{Binding Courses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DownloadCourseRow">
                  <Border Classes="card" Margin="0,0,0,8">
                    <StackPanel>
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontSize="13"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="faint" FontSize="11">
                            <Run Text="{Binding SubText}" /><Run Text="  " /><Run Text="{Binding CatalogSummary}" />
                          </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="＋ 全部下载" Margin="10,0,0,0"
                                Command="{Binding $parent[UserControl].((vm:DownloadViewModel)DataContext).DownloadAllCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="按目录顺序下载本课全部可下载课件（多视频=多条任务；目录未加载会自动加载）" />
                        <TextBlock Grid.Column="2" Text="加载中…" Classes="faint" FontSize="11"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   IsVisible="{Binding IsLoading}" />
                        <Button Grid.Column="3" Margin="10,0,0,0"
                                Content="{Binding ExpanderLabel}"
                                Command="{Binding $parent[UserControl].((vm:DownloadViewModel)DataContext).ToggleRowCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>

                      <!-- 展开的课件清单 -->
                      <ItemsControl ItemsSource="{Binding Wares}" IsVisible="{Binding IsExpanded}"
                                    Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:WareDownloadRow">
                            <Border Classes="card" Padding="10,6" Margin="0,0,0,4">
                              <Grid ColumnDefinitions="*,Auto,80,76,Auto">
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}" FontSize="12.5"
                                             TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding CatalogName}" Classes="faint" FontSize="10.5" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Duration}"
                                           Classes="dim" FontSize="11.5" VerticalAlignment="Center"
                                           MinWidth="64" TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding TypeLabel}"
                                           Classes="faint" FontSize="11" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <Button Grid.Column="4" Content="下载" Margin="10,0,0,0"
                                        IsEnabled="{Binding CanDownload}"
                                        Command="{Binding $parent[UserControl].((vm:DownloadViewModel)DataContext).DownloadCommand}"
                                        CommandParameter="{Binding}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="card">
              <TextBlock Classes="faint" FontSize="11.5" TextWrapping="Wrap"
                         Text="说明：视频课件从平台公开视频区下载（不占挂机流量、不影响心跳）；PDF/附件需要登录会话。产物按「保存目录/宝武学习助手/课程名/」两级归档；HLS 流合并为 .ts/.mp4 单文件，本机任意播放器可看。" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── 页签二：下载列表 ── -->
      <TabItem Header="{Binding TasksTabHeader}">
        <Grid RowDefinitions="Auto,*">
          <Border Classes="card" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Classes="faint" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"
                         Text="同时最多下 2 个；暂停后续传走断点，任务表落盘、重启不丢。" />
              <Button Grid.Column="1" Content="全部暂停" Margin="12,0,0,0"
                      Command="{Binding PauseAllCommand}" />
              <Button Grid.Column="2" Content="继续未竟" Margin="8,0,0,0"
                      Command="{Binding ResumeAllCommand}"
                      ToolTip.Tip="把排队/暂停/失败的任务重新排进队列（断点续传）" />
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1">
            <StackPanel>
              <Border Classes="card" IsVisible="{Binding !HasAnyTasks}" Padding="16,20">
                <StackPanel Spacing="4">
                  <TextBlock Text="还没有下载任务" FontSize="13" />
                  <TextBlock Classes="faint" FontSize="11.5" TextWrapping="Wrap"
                             Text="到「课程列表」页签展开课程，点课件右侧「下载」或课程右上「＋ 全部下载」，任务就会出现在这里。" />
                </StackPanel>
              </Border>

              <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DownloadTaskRow">
                    <Border Classes="card" Margin="0,0,0,6">
                      <!-- 三段固定列位：标题区吃掉剩余宽度，进度列固定 230，
                           按钮收进一个横排 StackPanel —— 列与列不重叠，窄窗口
                           时先压缩标题而不是挤压按钮（v1.0.45 布局修复） -->
                      <Grid ColumnDefinitions="*,230,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                          <TextBlock Text="{Binding Title}" FontSize="12.5"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="faint" FontSize="11">
                            <Run Text="{Binding CourseTitle}" /><Run Text=" · " /><Run Text="{Binding KindLabel}" />
                          </TextBlock>
                          <TextBlock Text="{Binding ErrorText}" FontSize="11"
                                     Foreground="#D9534F" TextWrapping="Wrap"
                                     IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Width="230" Spacing="3" VerticalAlignment="Center">
                          <TextBlock FontSize="11" Classes="dim">
                            <Run Text="{Binding StateText}" /><Run Text="  " /><Run Text="{Binding ProgressText}" />
                          </TextBlock>
                          <ProgressBar Height="5" CornerRadius="3" Minimum="0" Maximum="100"
                                       Value="{Binding Percent}" IsVisible="{Binding HasProgress}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                          <Button Content="暂停" IsVisible="{Binding CanPause}"
                                  Command="{Binding PauseCommand}" />
                          <Button Content="续传" IsVisible="{Binding CanResume}"
                                  Command="{Binding ResumeCommand}" />
                          <Button Content="打开" Command="{Binding OpenFolderCommand}"
                                  ToolTip.Tip="在文件管理器中定位已下载文件" />
                          <Button Content="移除" Command="{Binding RemoveCommand}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
